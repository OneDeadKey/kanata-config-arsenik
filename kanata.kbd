;;==========================================================================;;
;;                                                                          ;;
;;  Pick and choose the features you want for your keyboard:                ;;
;;  angle mod, layer-taps, navigation layer, Mac/Azerty/Qwertz support...   ;;
;;                                                                          ;;
;;==========================================================================;;

;; Note: if layer-taps are enabled (see the "Base layer" section below),
;; this configuration can be live-reloaded with Space+Backspace.

;; Timing variables for tap-hold effects. Keep the default values if unsure.
;; Ignored if layer-taps are not enabled.
(defvar

  ;; Minimum press time (ms) for "tap-preferred" dual keys: Nav and homerow mods.
  ;; Below this value, these keys just produce Space or a homerow letter.
  ;; Keep this value high if you struggle with home row mods.
  TAPPING_TERM 300

  ;; Maximum press time (ms) for "hold-preferred" dual keys: Enter and Backspace.
  ;; Above this value, these keys just behave as modifiers (Shift and Symbols).
  ;; Keep this value low if you trigger Enter by mistake.
  HOLDING_TERM 150

  ;; Maximum time (ms) for a double key press to enable repetitions.
  QUICK_TAP 200
)

;; Every section below should enable one and only one `include` statement.
;; Enable each feature by un-commenting the related line
;; (a commented line starts with ;;).


;;-----------------------------------------------------------------------------
;; Keyboard Geometry
;;-----------------------------------------------------------------------------
;; Pick the configuration matching your keyboard:
;; ISO (a.k.a. 102/105 keys) or ANSI (a.k.a. 101/104 keys).
;; If the key next to the left Shift is `Z`, your keyboard is ANSI.

(include defsrc/iso.kbd)
;; (include defsrc/ansi.kbd)


;;-----------------------------------------------------------------------------
;; Finger Assignment (angle-mod)
;;-----------------------------------------------------------------------------
;; Angle-mods can be enabled here, i.e. ZXCVB can be shifted to the left.
;; More details here: https://colemakmods.github.io/ergonomic-mods/angle.html

(include defsrc/layout.kbd)                ;; standard finger assignment
;; (include defsrc/layout_anglemod.kbd)       ;; ZXCVB are shifted to the left
;; (include defsrc/layout_wide_anglemod.kbd)  ;; angle-mod + right hand shifted by one key


;;-----------------------------------------------------------------------------
;; `Base` Layer (dual keys)
;;-----------------------------------------------------------------------------
;; Dual keys can be enabled here:
;;  - `lt` (layer-taps):
;;    - the right thumb key brings the `Symbols` layer
;;    - a long press on the space bar brings the `Navigation` layer
;;    - a quick tap on the left/right thumb key makes Backspace/Enter
;;  - `lt_hrm` (layer-taps + homerow-mods):
;;    - the left thumb key becomes Shift
;;    - SDF/JKL become Meta/Ctrl/Alt when held

(include deflayer/base.kbd)            ;; standard keyboard behavior
;; (include deflayer/base_lt.kbd)         ;; layer-taps on thumb keys
;; (include deflayer/base_lt_hrm_pc.kbd)  ;; layer-taps + homerow mods (PC)
;; (include deflayer/base_lt_hrm_mac.kbd) ;; layer-taps + homerow mods (Mac)

;; Note: not enabling layer-taps here makes the rest of the file useless.


;;-----------------------------------------------------------------------------
;; `Symbols` Layer
;;-----------------------------------------------------------------------------
;; Available options for the `Symbols` layer:
;;  - `noop`: the right thumb key acts as AltGr (PC) / Option (Mac)
;;  - `lafayette`: full symbol layer, inspired by QWERTY-Lafayette and Ergo-L
;;  - `num`: holding right thumb + left thumb brings a NumRow layer

(include deflayer/symbols_noop.kbd)           ;; AltGr/Option
;; (include deflayer/symbols_lafayette.kbd)      ;; prog layer
;; (include deflayer/symbols_noop_num.kbd)       ;; AltGr/Option + NumRow
;; (include deflayer/symbols_lafayette_num.kbd)  ;; prog layer + NumRow


;;-----------------------------------------------------------------------------
;; `Navigation` Layer: ESDF or HJKL?
;;-----------------------------------------------------------------------------

(include deflayer/navigation.kbd)      ;; arrows on ESDF, NumPad under the right hand
;; (include deflayer/navigation_vim.kbd)  ;; arrows on HJKL, NumPad on [Space]+[Q]


;;-----------------------------------------------------------------------------
;; Aliases for `Symbols` and `Navigation` Layers
;;-----------------------------------------------------------------------------
;; Symbols and shortcuts in the Navigation layer depend on the keyboard layout
;; and host type (PC/Mac). Pick your aliases accordingly.

(include defalias/qwerty_pc.kbd)            ;; QWERTY/Colemak PC
;; (include defalias/qwerty_mac.kbd)           ;; QWERTY/Colemak Mac
;; (include defalias/azerty_pc.kbd)            ;; AZERTY PC
;; (include defalias/qwertz_pc.kbd)            ;; QWERTZ PC
;; (include defalias/qwerty-lafayette_pc.kbd)  ;; QWERTY‑Lafayette PC
;; (include defalias/ergol_pc.kbd)             ;; Ergo‑L PC
;; (include defalias/bepo_pc.kbd)              ;; Bépo PC


;;-----------------------------------------------------------------------------
;; Extra Configuration
;;-----------------------------------------------------------------------------

(defcfg
  ;; Allow Kanata to process keys that are not defined in defsrc
  process-unmapped-keys yes
  ;; Fixes the AltGr/Symbols on Windows (see Arsenik issue #22)
  windows-altgr cancel-lctl-press
)

;; vim: set ft=lisp:
