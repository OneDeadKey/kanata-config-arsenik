;; Platform-specific Keys (ANSI)
;; lbot = bottom-left key = LeftShift = angle-mod substitution key

(deflocalkeys-linux
  LeftThumb   56 ;; LeftAlt
  RightThumb 100 ;; RightAlt
  lbot        42
)

(deflocalkeys-macos
  LeftThumb  125 ;; LeftCommand
  RightThumb 126 ;; RightCommand
  lbot        42
)

(deflocalkeys-win
  LeftThumb  164 ;; LeftAlt
  RightThumb 165 ;; RightAlt
  lbot       160
)
(deflocalkeys-winiov2
  LeftThumb  164 ;; LeftAlt
  RightThumb 165 ;; RightAlt
  lbot       160
)
(deflocalkeys-wintercept ;; XXX: untested
  LeftThumb  164 ;; LeftAlt
  RightThumb 165 ;; RightAlt
  lbot       160
)

