;; Base layer: layer-taps under the thumbs + home-row mods on SDF and JKL

(deflayer base
  _    _    _    _    _    _    _    _    _    _    _    _    _
  q    w    e    r    t         y    u    i    o    p
  a    @ss  @dd  @ff  g         h    @jj  @kk  @ll  ;
  z    x    c    v    b   lbot  n    m    ,    .    /
            @sft          @nav            @sym
)

;; Timing variables are defined in `kanata.kbd` file.

(defalias
  ;; Main mod-tap: Nav layer when held, Space when tapped.
  nav (tap-hold $QUICK_TAP $TAPPING_TERM spc (layer-while-held navigation))

  ;; Space-cadet thumb keys: Shift/BackSpace, AltGr/Enter.
  ;; Acts as a modifier by default, or as BackSpace/Enter when tapped separately.
  sft (tap-hold-press $QUICK_TAP $HOLDING_TERM bspc lsft)
  sym (tap-hold-press $QUICK_TAP $HOLDING_TERM ret (layer-while-held symbols))

  ;; Home-row mods
  ss (tap-hold $QUICK_TAP $TAPPING_TERM s lopt)
  dd (tap-hold $QUICK_TAP $TAPPING_TERM d lcmd)
  ff (tap-hold $QUICK_TAP $TAPPING_TERM f lctl)
  jj (tap-hold $QUICK_TAP $TAPPING_TERM j rctl)
  kk (tap-hold $QUICK_TAP $TAPPING_TERM k rcmd)
  ll (tap-hold $QUICK_TAP $TAPPING_TERM l lopt)
)

;; vim: set ft=lisp:
