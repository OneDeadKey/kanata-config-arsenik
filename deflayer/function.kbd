;; Function layer

(deflayer funmedia
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  f1   f2   f3   f4   XX        XX   XX   XX   XX   XX
  f5   f6   f7   f8   XX        XX   $HM1 $HM2 $HM3 XX
  f9   f10  f11  f12  XX   XX   XX   XX   XX   XX   XX
            _              _              _
)

(defalias
  ;; This should be a simple layer-shift, but Esc is kept on tap to be
  ;; forward-compatible with the previous spec. This will be deprecated.
  ;; fun (layer-while-held funmedia)
  fun (tap-hold-press $QUICK_TAP $HOLDING_TERM esc (layer-while-held funmedia))
)

